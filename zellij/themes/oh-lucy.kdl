            emphasis_2 "#555B6C"
            emphasis_3 "#555B6C"
        }
        frame_highlight {
            base       "#E39A65"
            background 0
            emphasis_0 "#AF98E6"
            emphasis_1 "#E39A65"
            emphasis_2 "#E39A65"
            emphasis_3 "#E39A65"
        }
        exit_code_success {
            base       "#76C5A4"
            background 0
            emphasis_0 "#FB7DA7"
            emphasis_1 "#555B6C"
