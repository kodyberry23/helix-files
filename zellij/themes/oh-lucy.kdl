// GENERATED by scripts/apply-theme.sh from themes/oh-lucy.toml -
// edit themes/<name>.toml or themes/templates/zellij.kdl.tmpl, NOT this file.
//
// Styled-components theme format (zellij 0.44+). Colors are "#RRGGBB"
// strings (accepted alongside RGB triples by the 0.44.2 parser). A bare
// `background 0` is ANSI palette index 0 - the setup's proven transparency
// slot: with ghostty's opacity < 1 it lets the window background show
// through unfocused chrome (and zellij stays pinned to 0.44.2 because
// 0.44.3 broke exactly this - see scripts/lib/common.sh).
themes {
    oh-lucy {
        text_unselected {
            base       "#D7D7D7"
            background 0
            emphasis_0 "#E39A65"
            emphasis_1 "#FB7DA7"
            emphasis_2 "#76C5A4"
            emphasis_3 "#AF98E6"
        }
        text_selected {
            base       "#E9E9E9"
            background "#272932"
            emphasis_0 "#E39A65"
            emphasis_1 "#FB7DA7"
            emphasis_2 "#76C5A4"
            emphasis_3 "#AF98E6"
        }
        ribbon_unselected {
            base       "#D7D7D7"
            background "#272932"
            emphasis_0 "#E39A65"
            emphasis_1 "#FB7DA7"
            emphasis_2 "#E9D26C"
            emphasis_3 "#AF98E6"
        }
        ribbon_selected {
            base       "#1B1D26"
            background "#D7D7D7"
            emphasis_0 "#E39A65"
            emphasis_1 "#FB7DA7"
            emphasis_2 "#76C5A4"
            emphasis_3 "#AF98E6"
        }
        table_title {
