// Deep Nord Aurora zellij configuration.
// Replaces the previous tmux setup. Keybindings keep zellij's mode-based
// model AND add direct Alt-key shortcuts that mirror the previous tmux
// setup so muscle memory carries over.

// Themes are GENERATED into zellij/themes/<name>.kdl by
// scripts/apply-theme.sh from the canonical themes/<name>.toml (edit those,
// not the .kdl files). zellij's default theme_dir is the config dir's
// themes/ subdirectory, which resolves here via the ~/.config/zellij
// symlink. External theme files load correctly on 0.44.1+ (0.44.0 silently
// ignored them - zellij-org/zellij#4909). zellij is brew-managed and
// unpinned: the suspected 0.44.3 transparency regression was refuted and
// the old 0.44.2 pin removed (see scripts/lib/common.sh). Colors in
// the generated files are "#RRGGBB" strings; `background 0` slots are the
// transparency passthrough that lets ghostty's window opacity show through.
// The line below is a pointer apply-theme.sh rewrites on theme switch;
// zellij watches config.kdl, so switching applies to live sessions.
theme "oh-lucy-evening"

// Skip the tip / release-notes screens that show on first launch and on
// version bumps. The user enters sessions exclusively via the `hs`
// sessionizer alias, which always invokes zellij with a session name.
show_startup_tips false
show_release_notes false

pane_frames true
rounded_corners true

default_mode "normal"
default_layout "default"

mouse_mode true
// Don't repaint pane frames when the mouse hovers - the highlight reads as
// "this pane is doing something" and competes with the focus accent.
mouse_hover_effects false
copy_command "pbcopy"
copy_on_select true
scroll_buffer_size 50000

// Detach (rather than terminate) on SIGTERM/SIGHUP so closing the Ghostty
// window leaves sessions resumable via `zellij attach`.
on_force_close "detach"

// Persist sessions (tabs, panes, cwds, running commands) so a crashed or
// closed Ghostty window can be reattached with state restored. Tradeoff:
// LSPs and editor processes get re-spawned on resurrection - fine for
// helix / yazi / shells.
session_serialization true
serialize_pane_viewport true

// Hide the session name from the pane-frame chrome - the session name is
// already in the status bar; doubling it on every frame is noise.
ui {
    pane_frames {
        hide_session_name true
    }
}

// Keybindings: keep zellij's mode-based defaults (Ctrl-p pane / Ctrl-t
// tab / Ctrl-n resize / Ctrl-s scroll / Ctrl-o session / Ctrl-g locked)
// and overlay direct Alt-key shortcuts.
keybinds {
    shared_except "locked" {
        // Tab management - direct (no mode prefix needed)
        bind "Alt t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        // Pane fullscreen toggle (was tmux M-f / prefix f)
        bind "Alt f" { ToggleFocusFullscreen; }
        // Pane frames are NOT bound to a direct Alt key: a stray Alt-z next to
        // Alt-t / Alt-w / Alt-f silently hid every frame for the life of the
        // session and looked like a broken theme. See the `pane` block below
        // for where the toggle lives now.
        // Detach (was tmux Ctrl-q). Replaces zellij's default Quit binding
        // - Quit is destructive (closes the session entirely); detach is
        // what's wanted 95% of the time. Quit is still reachable via
        // session mode (Ctrl-o, then `q`) or Alt-q below.
        bind "Ctrl q" { Detach; }
        bind "Alt q"  { Quit; }
    }
    pane {
        // zellij's default puts the pane-frame toggle on a bare `z` in pane
        // mode. Helix binds Ctrl-p as "previous entry" in pickers, prompts
        // and the completion menu, but zellij owns Ctrl-p in normal mode and
        // enters pane mode with it instead. This layout has no status bar,
        // so that mode switch is invisible, and the next `z` (helix view
        // mode, `zz`) toggled the frames off and dropped back to normal mode
        // as if nothing happened. Make the bare letter only return to normal
        // mode (a plain `unbind` would leave zellij parked in pane mode,
        // where the next helix `x` closes the editor pane) and put the toggle
        // on a chord nothing in helix produces.
        bind "z" { SwitchToMode "Normal"; }
        bind "Ctrl z" { TogglePaneFrames; SwitchToMode "Normal"; }
    }
}
