# GENERATED by scripts/apply-theme.sh from themes/{{meta.name}}.toml -
# edit themes/<name>.toml or themes/templates/helix.toml.tmpl, NOT this file.
#
# Scope rules are shared by every theme; colors come from the theme's
# purpose-named roles (see themes/<name>.toml [syntax]/[ui]/[colors]).

# ─── Syntax ───────────────────────────────────────────────────────────────
"attribute"                 = "synType"
"comment"                   = { fg = "synComment", modifiers = ["italic"] }
"constant"                  = "synConstant"
"constant.numeric"          = "synNumber"
"constant.character.escape" = "synSpecial"
"constant.builtin"          = "synNumber"
"constructor"               = "synSpecial"
"function"                  = "synFunction"
"function.macro"            = "synSpecial"
"function.method"           = "synFunction"
"function.builtin"          = "synFunction"
"keyword"                   = "synKeyword"
"keyword.control"           = "synKeyword"
"keyword.operator"          = "synNamespace"
"keyword.directive"         = "synNamespace"
"label"                     = "synNamespace"
"namespace"                 = "synNamespace"
"operator"                  = "synOperator"
"punctuation"               = "synPunct"
"punctuation.delimiter"     = "synPunct"
"punctuation.bracket"       = "synPunct"
"special"                   = "synConstant"
"string"                    = "synString"
"string.regexp"             = "synConstant"
"string.special"            = "synSpecial"
"tag"                       = "synNamespace"
"type"                      = "synType"
"type.builtin"              = "synTypeBuiltin"
"variable"                  = "synVariable"
"variable.builtin"          = "synKeyword"
"variable.parameter"        = "synVariable"
"variable.other.member"     = "synMember"

# ─── Markup ───────────────────────────────────────────────────────────────
"markup.heading"   = { fg = "accent", modifiers = ["bold"] }
"markup.heading.1" = { fg = "accentAlt", modifiers = ["bold"] }
"markup.heading.2" = { fg = "accent", modifiers = ["bold"] }
"markup.heading.3" = { fg = "accentDim", modifiers = ["bold"] }
"markup.heading.marker" = "fgMuted"
"markup.bold"      = { modifiers = ["bold"] }
"markup.italic"    = { modifiers = ["italic"] }
"markup.list"      = "accent"
"markup.link.url"  = { fg = "accentDim", underline = { style = "line" } }
"markup.link.text" = "accent"
"markup.quote"     = { fg = "fgMuted", modifiers = ["italic"] }
"markup.raw"       = "synString"

# ─── Diff ─────────────────────────────────────────────────────────────────
"diff.plus"  = "green"
"diff.minus" = "red"
"diff.delta" = "yellow"

# ─── UI ───────────────────────────────────────────────────────────────────
# `ui.background = {}` is an EXPLICIT empty style - not the same as omitting
# the key. Omitting it makes helix fall back to its built-in default theme's
# opaque background, which paints over ghostty's window transparency. The
# empty-table form tells helix "no fg, no bg, no modifiers" so cells render
# with terminal-default-bg (\e[49m) and ghostty's opacity shows through.
# (See helix-editor/helix#10223.) Only elements that need contrast - mode
# badges, cursors, selections, popups, the active statusline - declare a bg.
# With transparency disabled, terminal-default IS the opaque theme bg, so
# this needs no per-mode variant.
"ui.background"           = {}
"ui.background.separator" = "bgSurface"
# Gutter (line-number / sign column) needs its own explicit clear - helix
# paints it as a separate strip whose bg falls back to the default theme's
# opaque gutter, not to ui.background.
"ui.gutter"               = {}
# Cursor colour is unified across Helix / ZHM / Ghostty (the theme's
# ui.cursor role) so the focus point reads the same regardless of which app
# owns the cursor. Mode differentiation comes from cursor shape (set in
# helix/config.toml: block / bar / underline), not colour.
"ui.cursor"              = { fg = "bg", bg = "cursor" }
"ui.cursor.primary"      = { fg = "bg", bg = "cursor" }
"ui.cursor.match"        = { fg = "yellow", underline = { style = "line" } }
"ui.cursor.insert"       = { fg = "bg", bg = "cursor" }
"ui.cursor.select"       = { fg = "bg", bg = "cursor" }
"ui.linenr"              = { fg = "fgMuted" }
"ui.linenr.selected"     = { fg = "fg", modifiers = ["bold"] }
"ui.selection"           = { bg = "bgHighlight" }
"ui.selection.primary"   = { bg = "bgHighlight2" }

# Statusline - mode badges as indicator. The bar itself uses bgDark - one
# notch DARKER than the editor surface - so it reads as a recessed strip.
"ui.statusline"          = { fg = "fg", bg = "bgDark" }
"ui.statusline.inactive" = { fg = "fgMuted" }
"ui.statusline.normal"   = { fg = "bg", bg = "accent", modifiers = ["bold"] }
"ui.statusline.insert"   = { fg = "bg", bg = "green",  modifiers = ["bold"] }
"ui.statusline.select"   = { fg = "bg", bg = "yellow", modifiers = ["bold"] }

"ui.bufferline"          = { fg = "fgMuted" }
"ui.bufferline.active"   = { fg = "fgBright", modifiers = ["bold"] }

# Popups stay opaque so floating content is readable over transparent panes
"ui.popup"               = { bg = "bgSurface" }
"ui.popup.info"          = { fg = "fg", bg = "bgSurface" }
"ui.window"              = { fg = "fgMuted" }
"ui.help"                = { fg = "fg", bg = "bgSurface" }
"ui.menu"                = { fg = "fg", bg = "bgSurface" }
"ui.menu.selected"       = { fg = "bg", bg = "accent", modifiers = ["bold"] }
"ui.menu.scroll"         = { fg = "fg", bg = "bgHighlight" }
"ui.text"                = "fg"
"ui.text.focus"          = { fg = "fgBright", modifiers = ["bold"] }
"ui.text.inactive"       = "fgMuted"
"ui.virtual.whitespace"  = "bgHighlight"
"ui.virtual.indent-guide" = "bgSurface"
"ui.virtual.inlay-hint"  = { fg = "fgMuted", modifiers = ["italic"] }
"ui.virtual.inline-blame" = { fg = "fgMuted", modifiers = ["italic"] }
"ui.virtual.wrap"        = "fgMuted"
"ui.virtual.jump-label"  = { fg = "orange", modifiers = ["bold"] }

# ─── Diagnostics ──────────────────────────────────────────────────────────
"diagnostic.error"   = { underline = { color = "red",    style = "curl" } }
"diagnostic.warning" = { underline = { color = "yellow", style = "curl" } }
"diagnostic.info"    = { underline = { color = "accentAlt", style = "curl" } }
"diagnostic.hint"    = { underline = { color = "accent", style = "curl" } }
"error"   = "red"
"warning" = "yellow"
"info"    = "accent"
"hint"    = "accentAlt"

# ─── Palette ──────────────────────────────────────────────────────────────
# Values substituted from themes/{{meta.name}}.toml. Names are camelCase
# because helix's palette parser rejects underscores (logs: "Malformed
# ANSI: polar_dim"). [palette] must stay the LAST section of this file -
# TOML assigns every key after the header into it.
[palette]
bg           = "{{ui.bg}}"
bgDark       = "{{ui.bg_dark}}"
bgSurface    = "{{ui.bg_surface}}"
bgHighlight  = "{{ui.bg_highlight}}"
bgHighlight2 = "{{ui.bg_highlight2}}"
fg           = "{{ui.fg}}"
fgBright     = "{{ui.fg_bright}}"
fgMuted      = "{{ui.fg_muted}}"
cursor       = "{{ui.cursor}}"
accent       = "{{ui.accent}}"
accentAlt    = "{{ui.accent_alt}}"
accentDim    = "{{ui.accent_dim}}"
red    = "{{colors.red}}"
orange = "{{colors.orange}}"
yellow = "{{colors.yellow}}"
green  = "{{colors.green}}"
purple = "{{colors.purple}}"
blue   = "{{colors.blue}}"
synKeyword     = "{{syntax.keyword}}"
synFunction    = "{{syntax.function}}"
synString      = "{{syntax.string}}"
synType        = "{{syntax.type}}"
synTypeBuiltin = "{{syntax.type_builtin}}"
synConstant    = "{{syntax.constant}}"
synNumber      = "{{syntax.number}}"
synComment     = "{{syntax.comment}}"
synOperator    = "{{syntax.operator}}"
synPunct       = "{{syntax.punctuation}}"
synVariable    = "{{syntax.variable}}"
synMember      = "{{syntax.member}}"
synSpecial     = "{{syntax.special}}"
synNamespace   = "{{syntax.namespace}}"
