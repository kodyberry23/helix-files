// GENERATED by scripts/apply-theme.sh from themes/{{meta.name}}.toml -
// edit themes/<name>.toml or themes/templates/zellij.kdl.tmpl, NOT this file.
//
// Styled-components theme format (zellij 0.44+). Colors are "#RRGGBB"
// strings (accepted alongside RGB triples by the 0.44.2 parser). A bare
// `background 0` is ANSI palette index 0 - the setup's proven transparency
// slot: with ghostty's opacity < 1 it lets the window background show
// through unfocused chrome (and zellij stays pinned to 0.44.2 because
// 0.44.3 broke exactly this - see scripts/lib/common.sh).
themes {
    {{meta.name}} {
        text_unselected {
            base       "{{ui.fg}}"
            background 0
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        text_selected {
            base       "{{ui.fg_bright}}"
            background "{{ui.bg_surface}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        ribbon_unselected {
            base       "{{ui.fg}}"
            background "{{ui.bg_surface}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.yellow}}"
            emphasis_3 "{{colors.purple}}"
        }
        ribbon_selected {
            base       "{{ui.bg}}"
            background "{{ui.fg}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        table_title {
            base       "{{ui.accent}}"
            background 0
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        table_cell_unselected {
            base       "{{ui.fg}}"
            background "{{ui.bg_surface}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        table_cell_selected {
            base       "{{ui.fg_bright}}"
            background "{{ui.bg}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        list_unselected {
            base       "{{ui.fg}}"
            background "{{ui.bg_surface}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        list_selected {
            base       "{{ui.fg_bright}}"
            background "{{ui.bg}}"
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.green}}"
            emphasis_3 "{{colors.purple}}"
        }
        frame_selected {
            base       "{{ui.fg}}"
            background 0
            emphasis_0 "{{colors.orange}}"
            emphasis_1 "{{ui.accent}}"
            emphasis_2 "{{colors.purple}}"
            emphasis_3 0
        }
        frame_unselected {
            base       "{{ui.fg_muted}}"
            background 0
            emphasis_0 "{{ui.fg_muted}}"
            emphasis_1 "{{ui.fg_muted}}"
            emphasis_2 "{{ui.fg_muted}}"
            emphasis_3 "{{ui.fg_muted}}"
        }
        frame_highlight {
            base       "{{colors.orange}}"
            background 0
            emphasis_0 "{{colors.purple}}"
            emphasis_1 "{{colors.orange}}"
            emphasis_2 "{{colors.orange}}"
            emphasis_3 "{{colors.orange}}"
        }
        exit_code_success {
            base       "{{colors.green}}"
            background 0
            emphasis_0 "{{ui.accent}}"
            emphasis_1 "{{ui.fg_muted}}"
            emphasis_2 "{{colors.purple}}"
            emphasis_3 "{{colors.blue}}"
        }
        exit_code_error {
            base       "{{colors.red}}"
            background 0
            emphasis_0 "{{colors.yellow}}"
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1  "{{colors.purple}}"
            player_2  "{{colors.blue}}"
            player_3  0
            player_4  "{{colors.yellow}}"
            player_5  "{{ui.accent}}"
            player_6  0
            player_7  "{{colors.red}}"
            player_8  0
            player_9  0
            player_10 0
        }
    }
}
