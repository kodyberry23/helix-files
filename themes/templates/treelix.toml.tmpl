# GENERATED by scripts/apply-theme.sh from themes/{{meta.name}}.toml -
# edit themes/<name>.toml or themes/templates/treelix.toml.tmpl, NOT this file.
#
# Format:
#   [palette]   name = "#RRGGBB"
#   [styles]    element = "fg" | "fg / bg" | "fg / bg / mod,mod"
#               where fg/bg is a palette name, a #hex value, or "none".
#               modifiers: bold, italic, underline, dim, reversed.

[palette]
bg           = "{{ui.bg}}"
bgSurface    = "{{ui.bg_surface}}"
bgHighlight  = "{{ui.bg_highlight}}"
bgHighlight2 = "{{ui.bg_highlight2}}"
fg           = "{{ui.fg}}"
fgBright     = "{{ui.fg_bright}}"
fgMuted      = "{{ui.fg_muted}}"
accent       = "{{ui.accent}}"
accentAlt    = "{{ui.accent_alt}}"
folder       = "{{ui.folder}}"
red    = "{{colors.red}}"
orange = "{{colors.orange}}"
yellow = "{{colors.yellow}}"
green  = "{{colors.green}}"
purple = "{{colors.purple}}"

[styles]
text          = "fg"
# "none" keeps the terminal-default background so ghostty transparency
# shows through the sidebar (mirrors helix `ui.background = {}`).
background    = "none"
selection     = "none / bgHighlight2"
directory     = "folder / none / bold"
root          = "fgBright / none / bold"
indent_marker = "fgMuted"
arrow         = "fgMuted"
icon          = "fg"
folder_icon   = "folder"
symlink       = "accentAlt"
executable    = "green"
git_staged    = "green"
git_dirty     = "yellow"
git_deleted   = "red"
git_renamed   = "yellow"
git_conflict  = "red"
git_untracked = "orange"
git_ignored   = "fgMuted"
cut           = "red / none / italic"
copy          = "yellow"
special       = "yellow / none / bold"
opened        = "fgBright / none / bold"
bookmark      = "purple"
selected      = "none / bgHighlight"
help          = "fg"
help_title    = "accent / none / bold"
prompt        = "orange / none / bold"
filter_prefix = "purple / none / bold"
