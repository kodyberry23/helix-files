# GENERATED by scripts/apply-theme.sh from themes/{{meta.name}}.toml -
# edit themes/<name>.toml or themes/templates/ghostty.tmpl, NOT this file.
#
# Note: Ghostty's `palette = N=#hex` parser does not accept trailing
# comments on the same line - keep palette annotations on their own lines.
# Do NOT set background-opacity / background-blur here: `config-file`
# includes are processed at the END of the main config and would override
# the transparency toggle that apply-theme.sh writes into ghostty/config.

# ─── ANSI 0–7 ─────────────────────────────────────────────────────────────
palette = 0={{ansi.c0}}
palette = 1={{ansi.c1}}
palette = 2={{ansi.c2}}
palette = 3={{ansi.c3}}
palette = 4={{ansi.c4}}
palette = 5={{ansi.c5}}
palette = 6={{ansi.c6}}
palette = 7={{ansi.c7}}

# ─── ANSI 8–15 (bright) ───────────────────────────────────────────────────
palette = 8={{ansi.c8}}
palette = 9={{ansi.c9}}
palette = 10={{ansi.c10}}
palette = 11={{ansi.c11}}
palette = 12={{ansi.c12}}
palette = 13={{ansi.c13}}
palette = 14={{ansi.c14}}
palette = 15={{ansi.c15}}

# ─── Surface ──────────────────────────────────────────────────────────────
background           = {{ui.bg}}
foreground           = {{ansi.fg}}
# Cursor colour matches Helix `ui.cursor.*` and the ZHM_CURSOR_* overrides
# so the cursor looks the same in every layer.
cursor-color         = {{ui.cursor}}
cursor-text          = {{ui.bg}}
selection-background = {{ui.selection_bg}}
selection-foreground = {{ui.selection_fg}}
